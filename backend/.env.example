PORT=3000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=
MONGODB_URI=

# Wallet ownership verification (off-chain NEP-413 signatures).
# The backend supplies the selected network to the frontend. No signing keys are needed.
NEAR_NETWORK_ID=mainnet
# Optional trusted HTTPS RPC override; defaults to https://rpc.<network>.near.org.
NEAR_RPC_URL=
NEAR_RPC_TIMEOUT_MS=8000

# Agents on Intents partner credential. Keep this key on the backend only.
AGENTS_ON_INTENTS_PARTNER_API_KEY=
AGENTS_ON_INTENTS_BASE_URL=https://api.agentsonintents.com
# Allows the provider's maximum 30-second status wait, plus transport time.
AGENTS_ON_INTENTS_TIMEOUT_MS=35000
